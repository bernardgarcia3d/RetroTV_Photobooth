# Safe names only. Do not add real values to this tracked template.
# Real development values belong in supabase/functions/.env.paymongo.local.
# Live values belong in the hosted function's secret environment.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENVIRONMENT=test
PAYMONGO_API_BASE_URL=https://api.paymongo.com
# Time allowed between a webhook's signed timestamp and receipt. 300 is the default.
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
# One completed photo session can be claimed only during this window. 600 is the default.
PAYMONGO_SESSION_GRANT_TTL_SECONDS=600
